@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
	// The OAuth consent page sets HideNav: it stands on its own, without the admin area's navigation.
	var signedIn = User.Identity?.IsAuthenticated == true && ViewData["HideNav"] is not true;
	var csrfToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
	var section = ViewData["Section"] as string;
	string? Current(string name) => section == name ? "page" : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="color-scheme" content="light dark">
	<meta name="robots" content="noindex">
	<meta name="csrf-token" content="@csrfToken">
	<title>@ViewData["Title"] · Pebble Audio</title>
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
	<script type="module" src="~/js/admin.js" asp-append-version="true"></script>
</head>
<body>
	<header class="topbar">
		<div class="topbar-inner">
			<a class="brand" href="/admin">Pebble Audio</a>
			@if (signedIn)
			{
				<nav class="nav" aria-label="Admin">
					<a href="/admin" aria-current="@Current("status")">Status</a>
					<a href="/admin/apps" aria-current="@Current("apps")">Apps</a>
					<a href="/admin/tokens" aria-current="@Current("tokens")">Tokens</a>
					<a href="/admin/passkeys" aria-current="@Current("passkeys")">Passkeys</a>
					<a href="/admin/settings" aria-current="@Current("settings")">Settings</a>
				</nav>
				<form method="post" asp-page="/Admin/Logout" class="signout">
					<button type="submit" class="button button-quiet">Sign out</button>
				</form>
			}
		</div>
	</header>
	<main class="page">
		@RenderBody()
	</main>
</body>
</html>
