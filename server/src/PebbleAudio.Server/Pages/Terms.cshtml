@page "/terms"
@{
	ViewData["Title"] = "Terms";
	ViewData["Bare"] = true;
}
<div class="legal">
	<h1 class="screen-title">Terms</h1>
	<p class="lede">This is a personal server for one person's archive.</p>

<section class="card" aria-labelledby="use-heading">
	<h2 id="use-heading">Using it</h2>
	<p>Only its owner and the assistants the owner connects may use it. Don't try to reach anything else on it.</p>
	<p>It's provided as is, without any warranty, and may change or stop at any time.</p>
	<p>How it handles the archive is on the <a href="/privacy">privacy page</a>.</p>
</section>

<p class="footer">Questions: <a href="https://github.com/OkGoDoIt/pebble-audio-companion/issues">github.com/OkGoDoIt/pebble-audio-companion/issues</a></p>
</div>
