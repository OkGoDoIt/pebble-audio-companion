@* One assistant's Disconnect, confirmed first in the words of the phone's assistant screen (round-3 08). *@
@model (PebbleAudio.Server.Pages.Admin.AccessRow Row, int Index)
@{
	var row = Model.Row;
	var id = $"disconnect-{Model.Index}";
}
<form method="post" asp-page-handler="Disconnect" asp-route-kind="@row.Kind" asp-route-id="@row.Id" data-confirm>
	<button type="submit" class="btn small danger" aria-label="Disconnect @row.Name">Disconnect</button>
	<dialog class="confirm" aria-labelledby="@id-h">
		<p class="h" id="@id-h">Disconnect @row.Name?</p>
		<p>@row.Name can't read your server after this. @(row.Afterwards ?? "What it already read stays in your chats with it.")</p>
		<div class="acts">
			<button type="submit" class="danger" data-confirmed>Disconnect</button>
			<button type="button" data-cancel>Cancel</button>
		</div>
	</dialog>
</form>
