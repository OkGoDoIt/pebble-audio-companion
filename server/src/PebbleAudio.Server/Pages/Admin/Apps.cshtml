@page
@using PebbleAudio.Server.Auth
@using PebbleAudio.Server.Data
@using PebbleAudio.Server.Events
@model PebbleAudio.Server.Pages.Admin.AppsModel
@{
	ViewData["Title"] = "Connected apps";
	ViewData["Section"] = "apps";
}
<header class="page-header">
	<h1>Connected apps</h1>
	<p class="lede">Assistants you allowed with your passkey.</p>
</header>

<section class="card" aria-labelledby="connected-heading">
	<h2 id="connected-heading">Can open your archive</h2>
	@if (Model.Connected.Count == 0)
	{
		<p class="muted">No apps yet. Add <code>@Model.McpUrl</code> as a custom connector in ChatGPT or Claude.</p>
	}
	else
	{
		<ul class="rows">
			@foreach (var (app, connection) in Model.Connected)
			{
				<li class="row">
					<div class="row-main">
						<strong class="row-title">@app.Name</strong>
						<span class="row-meta">
							<span class="badge">@ArchiveScopes.Describe(connection.Scopes)</span>
							<span>@AppsModel.Place(connection)</span>
							<span>Connected @Display.Time(connection.ConnectedAt, "date")</span>
							@if (connection.LastUsedAt is { } lastUsed)
							{
								<span>Used @Display.Time(lastUsed, "relative")</span>
							}
							else
							{
								<span>Never used</span>
							}
						</span>
					</div>
					<form method="post" asp-page-handler="Disconnect" asp-route-id="@connection.GrantId">
						<button type="submit" class="button button-danger">Disconnect</button>
					</form>
				</li>
			}
		</ul>
	}
</section>

@if (Model.NotConnected.Count > 0)
{
	<section class="card" aria-labelledby="idle-heading">
		<h2 id="idle-heading">Not connected</h2>
		<ul class="rows">
			@foreach (var app in Model.NotConnected)
			{
				<li class="row">
					<div class="row-main">
						<strong class="row-title">@app.Name</strong>
						<span class="row-meta">
							@if (app.Host is { } host)
							{
								<span>@host</span>
							}
							<span>Added @Display.Time(app.CreatedAt, "date")</span>
						</span>
					</div>
					<form method="post" asp-page-handler="Remove" asp-route-id="@app.Id">
						<button type="submit" class="button">Remove</button>
					</form>
				</li>
			}
		</ul>
	</section>
}

<section class="card" aria-labelledby="events-heading">
	<h2 id="events-heading">Event subscriptions</h2>
	@if (Model.Subscriptions.Count == 0)
	{
		<p class="muted">No assistant is watching for events.</p>
	}
	else
	{
		<ul class="rows">
			@foreach (var subscription in Model.Subscriptions)
			{
				<li class="row">
					<div class="row-main">
						<strong class="row-title">@EventCatalog.Label(subscription.EventName)</strong>
						<span class="row-meta">
							<span>@subscription.ClientName</span>
							<span>@AppsModel.Host(subscription.CallbackUrl)</span>
							@if (subscription.LastDeliveredAt is { } delivered)
							{
								<span>Delivered @Display.Time(delivered, "relative")</span>
							}
							else
							{
								<span>Nothing delivered yet</span>
							}
							@if (subscription.ExpiresAt is { } expires)
							{
								<span>Ends @Display.Time(expires, "relative") unless renewed</span>
							}
						</span>
						@if (subscription.LastError is { } error)
						{
							<span class="row-error">@error</span>
						}
					</div>
					<form method="post" asp-page-handler="Unsubscribe" asp-route-id="@subscription.Id">
						<button type="submit" class="button">Remove</button>
					</form>
				</li>
			}
		</ul>
	}
</section>
