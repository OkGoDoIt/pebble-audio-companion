@page
@using PebbleAudio.Server.Auth
@using PebbleAudio.Server.Data
@model PebbleAudio.Server.Pages.Admin.TokensModel
@{
	ViewData["Title"] = "Tokens";
	ViewData["Section"] = "tokens";
}
<header class="page-header">
	<h1>Access tokens</h1>
	<p class="lede">For assistants and command-line tools that read the archive.</p>
</header>

@if (Model.Created is { } created)
{
	<section class="card card-accent" aria-labelledby="created-heading">
		<h2 id="created-heading">Token created</h2>
		<p>Copy it now. It won't be shown again.</p>
		<div class="copy-field">
			<code id="new-token">@created.Secret</code>
			<button type="button" class="button" data-copy="#new-token">Copy</button>
		</div>
		<h3>Add it to Claude Code</h3>
		<div class="copy-field">
			<code id="claude-command">claude mcp add --transport http pebble-audio @Model.McpUrl --header "Authorization: Bearer @created.Secret"</code>
			<button type="button" class="button" data-copy="#claude-command">Copy</button>
		</div>
	</section>
}

<section class="card" aria-labelledby="new-heading">
	<h2 id="new-heading">New token</h2>
	<form method="post" asp-page-handler="Create" class="form">
		<label class="field">
			<span class="field-label">Name</span>
			<input asp-for="Input.Name" maxlength="80" placeholder="Claude Code on my Mac" autocomplete="off">
			<span asp-validation-for="Input.Name" class="field-error"></span>
		</label>
		<fieldset class="field">
			<legend class="field-label">Access</legend>
			<div class="choices">
				@foreach (var access in Enum.GetValues<TokenAccess>())
				{
					<label class="choice">
						<input type="radio" asp-for="Input.Access" value="@access">
						<span>@ArchiveScopes.Describe(access)</span>
					</label>
				}
			</div>
		</fieldset>
		<div class="actions">
			<button type="submit" class="button button-primary">Create token</button>
		</div>
	</form>
</section>

<section class="card" aria-labelledby="tokens-heading">
	<h2 id="tokens-heading">Your tokens</h2>
	@if (Model.Tokens.Count == 0)
	{
		<p class="muted">No tokens yet.</p>
	}
	else
	{
		<ul class="rows">
			@foreach (var token in Model.Tokens)
			{
				<li class="row">
					<div class="row-main">
						<strong class="row-title">@token.Name</strong>
						<span class="row-meta">
							<span class="badge">@ArchiveScopes.Describe(token.Access)</span>
							<code>@token.Preview…</code>
							<span>Created @Display.Time(token.CreatedAt, "date")</span>
							@if (token.LastUsedAt is { } lastUsed)
							{
								<span>Used @Display.Time(lastUsed, "relative")</span>
							}
							else
							{
								<span>Never used</span>
							}
						</span>
					</div>
					<form method="post" asp-page-handler="Revoke" asp-route-id="@token.Id">
						<button type="submit" class="button button-danger">Revoke</button>
					</form>
				</li>
			}
		</ul>
	}
</section>

<section class="card" aria-labelledby="url-heading">
	<h2 id="url-heading">Server URL</h2>
	<div class="copy-field">
		<code id="mcp-url">@Model.McpUrl</code>
		<button type="button" class="button" data-copy="#mcp-url">Copy</button>
	</div>
</section>
