@page "/sign-in"
@model PebbleAudio.Server.Pages.Admin.LoginModel
@{
	ViewData["Title"] = "Sign in";
	ViewData["Bare"] = true;
}
<div class="auth">
	<form class="card" data-passkey="sign-in" data-return-url="@Model.ReturnUrl">
		<h1 class="screen-title">Sign in</h1>
		<p class="lede">@(Model.ForConnection ? "Use your passkey to connect an app to your conversations." : "Use your passkey to open Pebble Audio.")</p>
		<button type="submit" class="btn filled">Sign In with Passkey</button>
		<p class="status" data-status role="status"></p>
	</form>
</div>
