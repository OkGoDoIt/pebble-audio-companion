@page
@model PebbleAudio.Server.Pages.Admin.IndexModel
@{
	ViewData["Title"] = "Status";
	ViewData["Section"] = "status";
	var status = Model.Status;
}
<header class="page-header">
	<h1>Archive</h1>
	<p class="sync sync-@Model.Freshness.ToString().ToLowerInvariant()">
		<span class="sync-dot" aria-hidden="true"></span>
		@if (status.LastSyncAt is { } lastSync)
		{
			<span>Last synced @Display.Time(lastSync, "relative")</span>
		}
		else if (status.LinkedPhones == 0)
		{
			<span>No phone linked yet. <a href="/admin/phones">Link a phone</a></span>
		}
		else
		{
			<span>Waiting for the first sync</span>
		}
	</p>
</header>

<section class="stats" aria-label="What the archive holds">
	@foreach (var (label, count) in Model.Counts)
	{
		<div class="stat">
			<span class="stat-value">@Display.Count(count)</span>
			<span class="stat-label">@label</span>
		</div>
	}
</section>

<section class="card">
	<dl class="facts">
		<div>
			<dt>Days on record</dt>
			<dd>
				@if (status.FirstDay is { } first && status.LastDay is { } last)
				{
					@(first == last ? Display.Day(first) : $"{Display.Day(first)} – {Display.Day(last)}")
				}
				else
				{
					<span class="muted">None yet</span>
				}
			</dd>
		</div>
		<div>
			<dt>Linked phones</dt>
			<dd>@Display.Count(status.LinkedPhones)</dd>
		</div>
		<div>
			<dt>Waiting for the phone</dt>
			<dd>@(status.PendingRequests == 1 ? "1 request" : $"{Display.Count(status.PendingRequests)} requests")</dd>
		</div>
	</dl>
</section>

<p class="footnote">Version @AppVersion.Number@(AppVersion.Commit is { } commit ? $" ({commit})" : "")</p>
