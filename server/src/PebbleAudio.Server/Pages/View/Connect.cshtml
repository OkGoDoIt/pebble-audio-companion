@page "/connect/{tool}"
@model PebbleAudio.Server.Pages.View.ConnectModel
@using PebbleAudio.Server.Pages.View
@{
	Layout = "_ServerLayout";
	var tool = Model.Tool;
	ViewData["Title"] = tool.Kind == ConnectKind.Other ? "Connect another assistant" : $"Connect {tool.Name}";
	ViewData["Section"] = "connect";
}
@section Head {
	<script type="module" src="~/js/view/connect.js" asp-append-version="true"></script>
}
<div class="connect" data-connect data-tool="@tool.Key" data-name="@tool.Name" data-since="@Model.Since" data-waits="@(tool.Waits ? "true" : "false")">
	<div class="col">
		<h1 class="screen-title">@ViewData["Title"]</h1>
		@switch (tool.Kind)
		{
			case ConnectKind.Web:
				<partial name="_ConnectWeb" model="Model" />
				break;
			case ConnectKind.Muse:
				<partial name="_ConnectMuse" model="Model" />
				break;
			case ConnectKind.Pebble:
				<partial name="_ConnectPebble" model="Model" />
				break;
			case ConnectKind.Other:
				<partial name="_ConnectOther" model="Model" />
				break;
			default:
				<partial name="_ConnectMac" model="Model" />
				break;
		}
	</div>
	<div class="aside" data-who-slot>
		<partial name="_Who" model="Model" />
	</div>
</div>
