@page "/connect/{tool}"
@model PebbleAudio.Server.Pages.View.ConnectModel
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Html
@using PebbleAudio.Server.Pages.View
@{
	Layout = "_ServerLayout";
	var tool = Model.Tool;
	ViewData["Title"] = tool.Kind == ConnectKind.Other ? "Connect another assistant" : $"Connect {tool.Name}";
	ViewData["Section"] = "connect";
	var cursor = tool.Key == "cursor";
	var plural = tool.Key == "codex" ? "these commands" : "this command";
	IHtmlContent Marked(string command, string key)
	{
		var encoded = HtmlEncoder.Default.Encode(command);
		var encodedKey = HtmlEncoder.Default.Encode(key);
		return new HtmlString(encoded.Replace(encodedKey, $"<span class=\"k\">{encodedKey}</span>"));
	}
}
@section Head {
	<script type="module" src="~/js/view/connect.js" asp-append-version="true"></script>
}
<div class="connect" data-connect data-tool="@tool.Key" data-since="@Model.Since" data-waits="@(tool.Waits ? "true" : "false")">
	<div class="col">
		<h1 class="screen-title">@ViewData["Title"]</h1>

		@switch (tool.Kind)
		{
			case ConnectKind.Web:
				<p class="lede">@tool.Name signs in with your passkey, so it can read your conversations.</p>
				<partial name="_Address" model="(Model.Host, Model.McpUrl)" />
				<div class="card tool-card">
					@if (tool.Key == "chatgpt")
					{
						<ol class="open-steps">
							<li><span>In ChatGPT, open <b>Plugins</b> and click <b>Add</b>.</span></li>
							<li><span>Click <b>Add custom MCP server</b> and name it <b>Pebble Audio</b>.</span></li>
							<li><span>Under <b>Server URL</b>, paste your server address.</span></li>
							<li><span>Choose <b>OAuth</b>, tick <b>I understand and want to continue</b>, then click <b>Create as a plugin</b>.</span></li>
							<li><span>Sign in to your server with your passkey.</span></li>
						</ol>
						<a class="btn filled" href="@ConnectModel.ChatGptUrl" target="_blank" rel="noopener">@SiteIcons.External<span>Open ChatGPT</span></a>
					}
					else
					{
						<ol class="open-steps">
							<li><span>Click <b>Open Claude</b>. Your server is already filled in.</span></li>
							<li><span>Click <b>Connect</b>.</span></li>
							<li><span>Sign in to your server with your passkey.</span></li>
						</ol>
						<a class="btn filled" href="@Model.ClaudeUrl" target="_blank" rel="noopener">@SiteIcons.External<span>Open Claude</span></a>
						<p class="alt">Or in Claude, open <b>Settings › Connectors</b>, click <b>Add custom connector</b>, and paste your server address.</p>
					}
					<partial name="_Wait" model="Model" />
				</div>
				break;

			case ConnectKind.Muse:
				<div class="card">
					<div class="intro">
						<span class="circle" aria-hidden="true">@SiteIcons.Watch</span>
						<div>
							<p class="h">Muse connects through your watch</p>
							<p>Set it up in Pebble Audio on your iPhone, in <b>Settings › Muse</b>.</p>
						</div>
					</div>
				</div>
				break;

			case ConnectKind.Other:
				<p class="lede">Any assistant that adds a custom connector can sign in with your passkey.</p>
				<partial name="_Address" model="(Model.Host, Model.McpUrl)" />
				<div class="card tool-card">
					<ol class="open-steps">
						<li><span>In that assistant, find where it adds a custom connector or server.</span></li>
						<li><span>Paste your server address.</span></li>
						<li><span>Sign in to your server with your passkey.</span></li>
					</ol>
				</div>
				@if (Model.Key is { } otherKey)
				{
					<section class="group" id="key" aria-labelledby="key-h">
						<h2 class="section-header" id="key-h">Your access key</h2>
						<div class="card key-form">
							<pre class="cmd flat" id="cmd"><span class="k">@otherKey</span></pre>
							<button type="button" class="btn filled inline" data-copy="#cmd">@SiteIcons.Copy<span>Copy Key</span></button>
							<p class="note">Paste it where that assistant asks for a key, with your server address. It's shown only once.</p>
						</div>
					</section>
				}
				else
				{
					<section class="group" id="key" aria-labelledby="key-h">
						<h2 class="section-header" id="key-h">Can't sign in with a passkey?</h2>
						<form method="post" asp-page-handler="Key" asp-route-tool="@tool.Key" class="card key-form">
							<div>
								<label class="field-label" for="key-name">Name</label>
								<input class="field" id="key-name" asp-for="Input.Name" placeholder="Gemini" maxlength="80" autocomplete="off">
								<span asp-validation-for="Input.Name" class="field-error"></span>
							</div>
							<div class="switch-row">
								<label for="key-add">Can also add follow-ups and notes</label>
								<input class="switch" type="checkbox" role="switch" id="key-add" name="Input.CanAdd" value="true">
							</div>
							<button type="submit" class="btn bordered inline">Make an Access Key</button>
						</form>
						<p class="footer">An access key works for that assistant only, and it's shown once.</p>
					</section>
				}
				break;

			default:
				<p class="lede">@tool.Name signs in with your passkey, so it can read your conversations.</p>
				<nav class="seg" aria-label="App">
					@foreach (var t in ConnectModel.MacTools)
					{
						<a href="@ConnectModel.ToolUrl(t)" class="@(t == tool ? "on" : null)" aria-current="@(t == tool ? "page" : null)">@t.Name</a>
					}
				</nav>

				<ol class="card steps-card">
					@if (Model.Key is { } key)
					{
						<li class="stepn">
							<span class="n" aria-hidden="true">1</span>
							<div class="g">
								@if (cursor)
								{
									<span class="t">Click Add to Cursor</span>
									<a class="btn filled inline" href="@Model.KeyCommand(key)">@SiteIcons.External<span>Add to Cursor</span></a>
									<span class="note">The access key is in this button. Leave this page and you'll get a new one.</span>
								}
								else
								{
									<span class="t">Copy @plural</span>
									<pre class="cmd" id="cmd">@Marked(Model.KeyCommand(key), key)</pre>
									<button type="button" class="btn filled inline" data-copy="#cmd">@SiteIcons.Copy<span>Copy Command@(tool.Key == "codex" ? "s" : "")</span></button>
									<span class="note">The access key is shown once. Leave this page and you'll get a new one.</span>
								}
							</div>
						</li>
						<li class="stepn">
							<span class="n" aria-hidden="true">2</span>
							<div class="g">
								@if (cursor)
								{
									<span class="t">Confirm in Cursor</span>
								}
								else
								{
									<span class="t">Paste @(tool.Key == "codex" ? "them" : "it") into Terminal on your Mac and press Return</span>
									@if (tool.Key == "codex")
									{
										<span class="note">Then open a new Terminal window and start Codex.</span>
									}
									@if (Model.OnIPhone)
									{
										<span class="note">Copied on this iPhone, it pastes on a Mac signed in to the same Apple Account.</span>
									}
								}
							</div>
						</li>
					}
					else
					{
						<li class="stepn">
							<span class="n" aria-hidden="true">1</span>
							<div class="g">
								@if (cursor)
								{
									<span class="t">Click Add to Cursor</span>
									<a class="btn filled inline" href="@Model.OAuthCommand">@SiteIcons.External<span>Add to Cursor</span></a>
									@if (Model.OnIPhone)
									{
										<span class="note">Open this page on your Mac to use the button.</span>
									}
								}
								else
								{
									<span class="t">Copy @plural</span>
									<pre class="cmd" id="cmd">@Model.OAuthCommand</pre>
									<button type="button" class="btn filled inline" data-copy="#cmd">@SiteIcons.Copy<span>Copy Command@(tool.Key == "codex" ? "s" : "")</span></button>
								}
							</div>
						</li>
						<li class="stepn">
							<span class="n" aria-hidden="true">2</span>
							<div class="g">
								@switch (tool.Key)
								{
									case "cursor":
										<span class="t">Confirm in Cursor</span>
										<span class="note">Cursor asks you to sign in. Use your passkey, then allow access.</span>
										break;
									case "claude-code":
										<span class="t">Paste it into Terminal on your Mac and press Return</span>
										<span class="note">Then type /mcp in Claude Code, choose pebble-audio, and sign in with your passkey.</span>
										break;
									default:
										<span class="t">Paste them into Terminal on your Mac and press Return</span>
										<span class="note">Your browser opens to sign in. Use your passkey, then allow access.</span>
										break;
								}
								@if (Model.OnIPhone && !cursor)
								{
									<span class="note">Copied on this iPhone, it pastes on a Mac signed in to the same Apple Account.</span>
								}
							</div>
						</li>
					}
					<li class="stepn">
						<span class="n" aria-hidden="true">3</span>
						<div class="g">
							<span class="t">Ask @tool.Name about your conversations</span>
							<partial name="_Wait" model="Model" />
						</div>
					</li>
				</ol>

				@if (Model.Key is null)
				{
					<form method="post" asp-page-handler="Key" asp-route-tool="@tool.Key" class="fallback">
						<p class="fallback-head">No browser on that Mac?</p>
						<p class="note">Use an access key instead. It is shown once, and only this app gets it.</p>
						<button type="submit" class="btn small bordered">Make an Access Key</button>
					</form>
				}
				else
				{
					<p class="fallback"><a class="btn small plain" href="@ConnectModel.ToolUrl(tool)">Sign in with the browser instead</a></p>
				}
				break;
		}
	</div>
	@if (tool.Kind != ConnectKind.Muse)
	{
		<div class="aside" data-who-slot>
			<partial name="_Who" model="Model" />
		</div>
	}
</div>
