@model PebbleAudio.Server.Pages.View.ConnectModel
@using PebbleAudio.Server.Pages.View
<div class="who-list group" data-who data-ready="@(Model.Ready ? "true" : "false")" aria-live="polite">
	<p class="section-header" id="who-h">Who can read</p>
	<ul class="list-card" aria-labelledby="who-h">
		@foreach (var row in Model.Who)
		{
			<li class="row">
				@BrandMarks.Tile(row.Name)
				<span class="grow"><span class="t strong">@row.Name</span><span class="s">@row.Line</span></span>
				@if (row.Waiting)
				{
					<span class="spinner" role="img" aria-label="Waiting"></span>
				}
				else if (row.Arrived)
				{
					<span class="check-badge" role="img" aria-label="Connected">@SiteIcons.Check</span>
				}
			</li>
		}
		@if (Model.Who.Count == 0)
		{
			<li class="row"><span class="grow"><span class="t quiet">No assistant is connected yet.</span></span></li>
		}
	</ul>
	<p class="footer">Each app connects on its own. Disconnecting one stops only that app.</p>
</div>
