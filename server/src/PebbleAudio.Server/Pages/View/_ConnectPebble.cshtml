@* The Pebble plugin (Pebble app › Apps › Plugins › Pebble Audio): its settings page takes a one-time code shown here,
   and the plugin then shows up in Who can read like any other access, read-only. *@
@model PebbleAudio.Server.Pages.View.ConnectModel
@using PebbleAudio.Server.Pages.View
@using PebbleAudio.Server.Sync
@{
	var tool = Model.Tool;
}
<p class="lede">Show your recording status and today's conversations on your watch.</p>
<div class="card tool-card">
	<ol class="open-steps">
		<li><span>In the Pebble app, open <b>Apps › Plugins › Pebble Audio</b> and tap <b>Settings</b>.</span></li>
		@if (Model.PluginCode is { } minted)
		{
			var code = minted.Code;
			<li>
				<div>
					Enter this code.
					<div class="code-boxes" data-code="@PhoneLinkService.Display(code)" role="img" aria-label="Code @PhoneLinkService.Display(code)">
						@for (var i = 0; i < code.Length; i++)
						{
							if (i == 4)
							{
								<span class="gap"></span>
							}
							<span class="box">@code[i]</span>
						}
					</div>
				</div>
			</li>
		}
		else
		{
			<li><span>Show a code here and enter it there.</span></li>
		}
	</ol>
	@if (Model.PluginCode is null)
	{
		<form method="post" asp-page-handler="Code" asp-route-tool="@tool.Key">
			<button type="submit" class="btn filled inline">Show a Code</button>
		</form>
	}
	@if (Model.PluginCode is not null || Model.Ready)
	{
		<partial name="_Wait" model="Model" />
	}
</div>
@if (Model.PluginCode is { } shown)
{
	var minutes = Math.Max(1, (int)Math.Round((shown.ExpiresAt - Model.Now).TotalMinutes));
	<p class="footer">It works once, for the next @(minutes == 1 ? "minute" : $"{minutes} minutes").</p>
	<form method="post" asp-page-handler="Code" asp-route-tool="@tool.Key">
		<button type="submit" class="btn small gray inline">Show a New Code</button>
	</form>
}
