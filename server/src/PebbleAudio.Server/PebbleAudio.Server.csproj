<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>PebbleAudio.Server</RootNamespace>
		<Version>0.1.0</Version>
		<!-- A switch over one of our enums that misses a member fails the build. Unnamed enum values
		     (CS8524) are not a concern: every enum comes from our own code or a parsed wire string. -->
		<WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
		<NoWarn>$(NoWarn);CS8524</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.13" />
		<PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
		<PackageReference Include="ModelContextProtocol.Extensions.Apps" Version="2.2.0" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
	</ItemGroup>

	<ItemGroup>
		<!-- Development settings (local database and origin) stay out of the release artifact. -->
		<Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
	</ItemGroup>

	<ItemGroup>
		<!-- The OAuth metadata documents of ChatGPT and Claude, used when a live fetch fails (Auth/OAuthClients.cs). -->
		<Content Remove="Auth/KnownClients/*.json" />
		<EmbeddedResource Include="Auth/KnownClients/*.json" LogicalName="KnownClients/%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="PebbleAudio.Server.Tests" />
	</ItemGroup>

</Project>
