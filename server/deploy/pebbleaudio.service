[Unit]
Description=Pebble Audio archive server
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=notify
User=pebbleaudio
Group=pebbleaudio
WorkingDirectory=/opt/pebbleaudio/current/app
EnvironmentFile=/etc/pebbleaudio/pebbleaudio.env
ExecStart=/opt/pebbleaudio/current/app/PebbleAudio.Server
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
SyslogIdentifier=pebbleaudio
# The droplet has 2 GB, shared with Postgres and other apps: the app and its ffmpeg children stop here rather
# than push a neighbour into the OOM killer. .NET sizes its heap to the limit (75% by default).
MemoryMax=768M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/pebbleaudio /opt/pebbleaudio /var/backups/pebbleaudio

[Install]
WantedBy=multi-user.target
